[Unit]
Description=Callendars Syncer single synchronization pass
Wants=network-online.target
After=network-online.target
Conflicts=gallendar.service

[Service]
Type=oneshot
User=gallendar
Group=gallendar
Environment=HOME=/srv/gallendar
Environment=CALLENDARS_SYNCER_CONFIG=/srv/gallendar/.x-cli-gallendar/config.toml
Environment=CALLENDARS_SYNCER_STATE=/srv/gallendar/callendars-syncer/state.sqlite3
Environment=CALLENDARS_SYNCER_LOGS=/srv/gallendar/callendars-syncer/logs
Environment=CALLENDARS_SYNCER_HEALTH_DIR=/srv/gallendar/health
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/srv/gallendar
ExecStart=/opt/callendars-syncer/current/venv/bin/callendars-syncer sync --apply --scheduled --json
TimeoutStartSec=10min
TimeoutStopSec=120
UMask=0077
MemoryMax=256M
CPUQuota=20%
TasksMax=32
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/srv/gallendar
