[Unit]
Description=SlotSync single synchronization pass
Wants=network-online.target
After=network-online.target
Conflicts=gallendar.service

[Service]
Type=oneshot
User=gallendar
Group=gallendar
Environment=HOME=/srv/gallendar
Environment=SLOT_SYNC_CONFIG=/srv/gallendar/.x-cli-gallendar/config.toml
Environment=SLOT_SYNC_STATE=/srv/gallendar/slot-sync/state.sqlite3
Environment=SLOT_SYNC_LOGS=/srv/gallendar/slot-sync/logs
Environment=SLOT_SYNC_HEALTH_DIR=/srv/gallendar/health
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/srv/gallendar
ExecStart=/opt/slot-sync/current/venv/bin/slot-sync sync --apply --scheduled --json
TimeoutStartSec=10min
TimeoutStopSec=120
UMask=0077
MemoryMax=256M
CPUQuota=20%
TasksMax=32
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/srv/gallendar
